<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen, touch-consuming blocking overlay. Gravity-centered so a WindowManager relayout
     on rotation repositions the button correctly without re-inflation. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0F0D"
    android:clickable="true"
    android:focusable="false">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overlay_title"
            android:textColor="#E8F0EB"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#9CC4AC"
            android:textSize="16sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/overlay_message"
            android:textColor="#8A9890"
            android:textSize="15sp" />

        <Button
            android:id="@+id/overlay_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/overlay_back" />
    </LinearLayout>
</FrameLayout>
